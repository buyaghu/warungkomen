      "start": 35.255,
      "after": 0.1
    },
    {
      "id": "l13",
      "text": "Bawang, serai, daun jeruk. Wangi euy!",
      "file": "l13.mp3",
      "start": 38.209,
      "after": 0.1
    },
    {
      "id": "l14",
      "text": "Nasi masuk, aduk-aduk... jadi dah!",
      "file": "l14.mp3",
      "start": 41.332,
      "after": 0.3
    },
    {
      "id": "l15",
      "text": "Tambah ayam geprek? Combo! Menu satu sama tiga!",
